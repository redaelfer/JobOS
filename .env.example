PORT=4317
# Optional if codex is not available on PATH:
# CODEX_BIN=C:/path/to/codex.exe
# Optional PDF compiler if MiKTeX/PATH detection is unavailable:
# TEX_BIN=C:/path/to/pdflatex.exe
# Optional: IMAP mailbox receiving your LinkedIn job-alert emails.
# Use an app password. Never commit your .env file.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_PORT=993

# AI provider and model are selected in the app's AI models page.
# Keys can be saved in that form, or supplied here in your private .env.
# Never put real keys in .env.example or chat.
# Gemini generation + Google Search: https://aistudio.google.com/apikey
# Paste the real key after = in .env, optionally enclosed in double quotes.
GEMINI_API_KEY=
# Kimi / Moonshot generation: https://platform.kimi.ai
MOONSHOT_API_KEY=
# A custom OpenAI-compatible hosted server; leave empty for local LM Studio
# unless your server requires authentication. Choose its model/address in the app.
AI_API_KEY=
# Ollama local generation and Public LinkedIn + web search need no API key.
# Select them in AI models; download the model first. See LOCAL-SETUP.md.
# Public websites can still block access. These optional hosted search keys
# are only used when their corresponding service is selected:
# Ollama WEB SEARCH key: https://ollama.com/settings/keys
# Downloaded Ollama models do not need an inference API key.
OLLAMA_API_KEY=
# Brave Search key: https://api-dashboard.search.brave.com
BRAVE_API_KEY=
