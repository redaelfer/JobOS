{
  "manifest_version": 3,
  "name": "JobOS — LinkedIn capture",
  "description": "Save a LinkedIn job and review the availability of saved postings in your browser.",
  "version": "0.3.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [{ "matches": ["http://127.0.0.1/*", "http://localhost/*"], "js": ["review-bridge.js"] }],
  "background": { "service_worker": "review-worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "Save to JobOS" }
}
